<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="$(var.ProductName)"
      Manufacturer="Gateinto"
      Version="$(var.Version)"
      UpgradeCode="2C50F196-F9CD-4535-A997-0687BEB31CDE"
      Scope="perUser"
      Language="1033"
      Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Gateinto is already installed. Uninstall it first, then install this one." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="AUTOSTART" Secure="yes" />
    <Property Id="CONFIGEXISTS" Secure="yes">
      <DirectorySearch Id="ConfigFolderSearch" Path="[AppDataFolder]Gateinto" Depth="0">
        <FileSearch Id="ConfigFileSearch" Name="gateinto.toml" />
      </DirectorySearch>
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Gateinto" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="ConfigFolder" Name="Gateinto" />
    </StandardDirectory>

    <Feature Id="Main" Title="Gateinto" Level="1" AllowAbsent="no">
      <Component Id="Executable" Directory="INSTALLFOLDER" Guid="D0BAAB5A-B9FF-4F34-9BBE-8F2E399F5E34">
        <File Id="GateintoExe" Name="gateinto.exe" Source="$(var.BinaryPath)" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Gateinto\Installer" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="Gui" Directory="INSTALLFOLDER" Guid="719E9D77-6A62-4A25-9EE3-00DC08543968">
        <File Id="GateintoGuiExe" Name="gateinto-gui.exe" Source="$(var.GuiBinaryPath)" KeyPath="no">
          <Shortcut Id="GuiShortcut" Name="Gateinto" Directory="ProgramMenuFolder" Description="Gateinto desktop window" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>
        <RegistryValue Root="HKCU" Key="Software\Gateinto\Installer" Name="Gui" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- The condition is evaluated only on first install. NeverOverwrite skips a repair or an
           upgrade while the marker value exists, and Permanent keeps the file on uninstall. -->
      <Component Id="ConfigTemplate" Directory="ConfigFolder" Guid="9198974C-56EF-465F-9ACC-55AC28F33369" Permanent="yes" NeverOverwrite="yes" Condition="NOT CONFIGEXISTS">
        <File Id="ConfigTemplateToml" Name="gateinto.toml" Source="$(sys.SOURCEFILEDIR)gateinto.toml" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Gateinto\Installer" Name="ConfigTemplate" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveConfigFolder" Directory="ConfigFolder" On="uninstall" />
      </Component>

      <Component Id="UriHandler" Directory="INSTALLFOLDER" Guid="7AFE4CDF-3B66-4F54-88E4-A3929B2B22E6">
        <RegistryKey Root="HKCU" Key="Software\Classes\gateinto" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="URL:Gateinto launch link" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]gateinto.exe&quot; open -- &quot;%1&quot;" />
        </RegistryKey>
      </Component>

      <Feature Id="Autostart" Title="Start the Gateinto agent at logon" Level="2">
        <Level Value="1" Condition="AUTOSTART = &quot;1&quot;" />
        <Component Id="Autostart" Directory="INSTALLFOLDER" Guid="3A1DFF58-BAE5-4BDB-A96C-0D54E6AB6039">
          <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Gateinto" Type="string" Value="&quot;[INSTALLFOLDER]gateinto.exe&quot; agent --detach" KeyPath="yes" />
        </Component>
      </Feature>
    </Feature>

    <CustomAction
        Id="StopAgent"
        FileRef="GateintoExe"
        ExeCommand="stop --remove-stale-profiles"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <CustomAction
        Id="UninstallGui"
        FileRef="GateintoGuiExe"
        ExeCommand="--uninstall"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <CustomAction
        Id="QuitGui"
        FileRef="GateintoGuiExe"
        ExeCommand="--quit"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopAgent" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UninstallGui" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="QuitGui" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
